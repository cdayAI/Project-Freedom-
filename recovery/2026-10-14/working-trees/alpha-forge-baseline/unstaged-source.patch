+def _load_dotenv(path: Path) -> None:
+    """Minimal .env loader: KEY=VALUE lines, '#' comments, no expansion.
+    Existing environment variables always win over the file."""
+    if not path.exists():
+        return
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
